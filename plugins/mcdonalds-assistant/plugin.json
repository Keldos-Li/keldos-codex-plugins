{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mcdonalds-assistant",
  "version": "1.3.4",
  "description": "查看活动、优惠券、营养、餐厅餐品和积分，提供交互面板。",
  "author": {
    "name": "Keldos Li",
    "url": "https://github.com/Keldos-Li"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "capabilities": [
          "Interactive"
        ],
        "category": "Other",
        "defaultPrompt": [
          "打开麦当劳面板",
          "查找附近的麦当劳并搭配午餐",
          "查看麦当劳活动、优惠券和积分"
        ],
        "developerName": "Keldos Li",
        "displayName": "麦当劳助手",
        "longDescription": "连接你自己的麦当劳中国账户，在聊天和交互面板中查询活动、优惠券、餐厅、菜单、餐品价格、热量、营养和积分。根据实际餐厅菜单、预算和偏好推荐餐品，分析餐品组合的营养信息，并在面板确认后领取优惠券。通过 OAuth 授权页面连接账户，使用者填写自己的麦当劳 MCP Token；可在连接管理页面解除授权并删除保存的 Token。",
        "shortDescription": "活动、优惠券、营养、餐厅和积分查询",
        "logo": "./assets/mcd-plugin-icon.png",
        "composerIcon": "./assets/mcd-plugin-icon.png",
        "websiteURL": "https://github.com/Keldos-Li/mcdonalds-plugins",
        "supportURL": "https://github.com/Keldos-Li/mcdonalds-plugins/issues"
      },
      "mcpServers": "./.mcp.json"
    }
  },
  "homepage": "https://github.com/Keldos-Li/mcdonalds-plugins",
  "repository": "https://github.com/Keldos-Li/mcdonalds-plugins",
  "keywords": [
    "mcdonalds",
    "麦当劳",
    "餐厅",
    "菜单",
    "营养",
    "优惠券",
    "积分",
    "mcp",
    "oauth"
  ]
}
