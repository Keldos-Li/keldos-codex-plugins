{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mcdonalds": {
      "type": "streamable-http",
      "url": "https://mcd-mcp.keldos.chatgpt.site/api/mcd-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcd:read"
            ],
            "defaultScopes": [
              "mcd:read",
              "mcd:coupons"
            ]
          }
        }
      }
    }
  }
}
